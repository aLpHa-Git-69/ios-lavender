diff --git a/pexpert/arm/pe_fiq.c b/pexpert/arm/pe_fiq.c
index 83da6e0..d838fcf 100644
--- a/pexpert/arm/pe_fiq.c
+++ b/pexpert/arm/pe_fiq.c
@@ -45,6 +45,26 @@ _gic_write32(vm_offset_t addr, uint32_t value)
 #define gicr_write32(offset, data) (_gic_write32(gicr_pe_base + (offset), (data)))
 #define gicr_read64(offset) (_gic_read64(gicr_pe_base + (offset)))
 
+#if defined(SWEET)
+/* Clover ArmCpu::waitClear(), b9ad635986998de400a7c1dec84f3e40a767e779:
+ * a stuck distributor RWP bit must identify itself, not spin forever.
+ * Use Darwin 22's existing clock API and a one-second software bound, as for
+ * redistributor wakeup. IRQ acknowledge/EOI remains exclusively in sleh_irq. */
+static void
+gicd_wait_rwp(void)
+{
+	uint64_t deadline;
+	uint32_t ctlr;
+
+	nanoseconds_to_deadline(1000000000ULL, &deadline);
+	while ((ctlr = gicd_read32(GICD_CTLR)) & GICD_CTLR_RWP) {
+		if (mach_absolute_time() >= deadline) {
+			panic("%s: GICD_CTLR.RWP timed out (0x%08x)", __func__, ctlr);
+		}
+	}
+}
+#endif
+
 static vm_offset_t
 find_gicr_pe_base()
 {
@@ -186,9 +206,7 @@ pe_init_fiq()
 	uint32_t gicd_ctlr = gicd_read32(GICD_CTLR);
 	gicd_ctlr |= GICD_CTLR_ARE_NS | GICD_CTLR_ENABLEGRP1A | GICD_CTLR_ENABLEGRP1;
 	gicd_write32(GICD_CTLR, gicd_ctlr);
-	while (gicd_read32(GICD_CTLR) & GICD_CTLR_RWP) {
-		;
-	}
+	gicd_wait_rwp();
 	__builtin_arm_wsr64("ICC_IGRPEN1_EL1", 1);
 	__builtin_arm_isb(ISB_SY);
 #else
